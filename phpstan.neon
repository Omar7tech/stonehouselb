includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Models declare their casts with the `casts()` method rather than the
    # `$casts` property, so Larastan has to read the method body to know that
    # e.g. `Product::$order_type` is an OrderType and not a plain string.
    parseModelCastsMethod: true
